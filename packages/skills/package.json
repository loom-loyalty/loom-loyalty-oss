{
  "name": "@loom-loyalty/skills",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Agent skills for Loom Loyalty: treadle, the API, program design, campaigns, offers and analytics",
  "engines": {
    "node": ">=18.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "loom-loyalty-skills": "./bin/loom-loyalty-skills.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src tests",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@loom-loyalty/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loom-loyalty/loom-loyalty-oss.git",
    "directory": "packages/skills"
  }
}
