{
  "name": "@loom-loyalty/ui",
  "version": "0.46.0",
  "description": "UI component library for Loom Loyalty applications",
  "private": false,
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./data-display": {
      "types": "./dist/data-display/index.d.ts",
      "import": "./dist/data-display/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js"
    },
    "./wizards": {
      "types": "./dist/wizards/index.d.ts",
      "import": "./dist/wizards/index.js"
    },
    "./animations": {
      "types": "./dist/animations/index.d.ts",
      "import": "./dist/animations/index.js"
    },
    "./entity": {
      "types": "./dist/entity/index.d.ts",
      "import": "./dist/entity/index.js"
    },
    "./expressions": {
      "types": "./dist/expressions/index.d.ts",
      "import": "./dist/expressions/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./openui": {
      "types": "./dist/openui/index.d.ts",
      "import": "./dist/openui/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "pnpm build:css && tsc",
    "build:css": "pnpm exec tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify",
    "dev": "pnpm build:css && tsc --watch",
    "dev:css": "pnpm exec tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:audit": "vitest run --testNamePattern '\\[audit\\]' --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "@tanstack/react-router": ">=1.130.0",
    "d3": ">=7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "d3": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.1",
