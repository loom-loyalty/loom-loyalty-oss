{
  "name": "@loom-loyalty/program-builder",
  "version": "0.6.9",
  "private": false,
  "license": "Apache-2.0",
  "description": "Shared program executor, spec types, linter, and shape-diff for Loom Loyalty program creation flows (wizard + AI)",
  "engines": {
    "node": ">=18.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./templates/*.md": "./templates/*.md"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "zod": ">=3.0.0"
  },
  "dependencies": {
    "@loom-loyalty/conventions": "workspace:*",
    "@loom-loyalty/sdk": "workspace:*",
    "exceljs": "4.4.0",
    "gray-matter": "4.0.3",
    "mammoth": "1.12.0",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@loom-loyalty/config": "workspace:*",
    "@types/mdast": "4.0.4",
    "@types/node": "catalog:",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loom-loyalty/loom-loyalty-oss.git",
    "directory": "packages/program-builder"
  }
}
