{
  "name": "@loom-loyalty/analytics",
  "version": "1.4.18",
  "private": false,
  "license": "Apache-2.0",
  "description": "TinyBird analytics data layer for Loom Loyalty",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./explorer": {
      "types": "./dist/explorer/index.d.ts",
      "import": "./dist/explorer/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./pipes": {
      "types": "./dist/pipes.d.ts",
      "import": "./dist/pipes.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@loom-loyalty/config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@loom-loyalty/core": "workspace:*",
    "@loom-loyalty/ui": "workspace:*",
    "date-fns": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loom-loyalty/loom-loyalty-oss.git",
    "directory": "packages/analytics"
  }
}
