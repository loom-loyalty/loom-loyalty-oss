{
  "name": "@loom-loyalty/auth",
  "version": "0.4.1",
  "private": false,
  "license": "Apache-2.0",
  "description": "WorkOS authentication for Loom Loyalty - server and client auth utilities",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jose": "catalog:"
  },
  "peerDependencies": {
    "@workos-inc/authkit-react": ">=0.15.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@workos-inc/authkit-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@loom-loyalty/config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workos-inc/authkit-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loom-loyalty/loom-loyalty-oss.git",
    "directory": "packages/auth"
  }
}
