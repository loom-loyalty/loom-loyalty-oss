{
  "name": "@loom-loyalty/test-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test utilities for the FE CRUD UI Audit — manifest loader, Zod refinements, axe matchers, MSW shim",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest/index.ts",
      "import": "./src/manifest/index.ts",
      "default": "./src/manifest/index.ts"
    },
    "./zod": {
      "types": "./src/zod/index.ts",
      "import": "./src/zod/index.ts",
      "default": "./src/zod/index.ts"
    },
    "./axe": {
      "types": "./src/axe/index.ts",
      "import": "./src/axe/index.ts",
      "default": "./src/axe/index.ts"
    },
    "./msw": {
      "types": "./src/msw/index.ts",
      "import": "./src/msw/index.ts",
      "default": "./src/msw/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axe-core": "4.11.3",
    "msw": "2.13.6",
    "vitest-axe": "0.1.0"
  },
  "peerDependencies": {
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loom-loyalty/config": "workspace:*",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "license": "Apache-2.0"
}
